   "source": [
    "import math\n",
    "\n",
    "def robust_softmax(x):\n",
    "    max_x = max(x)\n",
    "    data = [math.exp(i-max_x) for i in x]\n",
    "    sum_data = sum(data)\n",
    "    return [i/sum_data for i in data]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
