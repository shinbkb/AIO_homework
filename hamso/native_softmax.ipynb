   "source": [
    "import math"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d43c35f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def native_softmax(data):\n",
    "    exp_data = [math.exp(x) for x in data]\n",
    "    sum_exp_data = sum(exp_data)\n",
    "    return [x / sum_exp_data for x in exp_data]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c9697900",
   "metadata": {},
   "outputs": [],
   "source": [
    "z = [1000, 1001, 1002]\n",
    "print(native_softmax(z))"
   ]
  }
